# Copie ce fichier en ".env" pour tester sur ton PC. En ligne, ces valeurs se mettent dans Render.
# En local tout peut rester vide : base SQLite, secret créé tout seul, le premier compte créé est administrateur.

# Clé commune du site, partagée entre les inscrits qui n'ont pas mis la leur : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Facultatif : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# En ligne uniquement
DATABASE_URL=
SECRET_KEY=
ADMIN_EMAIL=
CRON_KEY=
APP_URL=
APP_NAME=Veille Stages

# Inscriptions : open (tout le monde), invite (avec INVITE_CODE), closed
SIGNUP_MODE=open
INVITE_CODE=

# Facultatif
CONTACT_EMAIL=
DONATE_URL=
TELEGRAM_TOKEN=
TELEGRAM_BOT=

# Secondes entre deux collectes automatiques (0 = désactivé)
COLLECT_EVERY_SEC=180
